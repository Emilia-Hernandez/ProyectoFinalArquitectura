		{"id":"metrics","type":"text","text":"Comparacion\\nSpark UI + CloudWatch\\ninput rate, processing rate, batch duration, shuffle, I/O, GC, spill, scheduler delay, hardware.","x":980,"y":-120,"width":350,"height":170,"color":"4"},
		{"id":"colab","type":"text","text":"Google Colab\\nUso recomendado: desarrollo, pruebas pequenas y entrenamiento puntual\\nNo es ideal para streaming permanente por sesiones efimeras.","x":-320,"y":20,"width":360,"height":160,"color":"6"},
		{"id":"external_kafka","type":"text","text":"Servicios externos para Colab\\nKafka externo / Redpanda Cloud\\nGoogle Drive o Cloud Storage para Parquet y modelo.","x":120,"y":20,"width":350,"height":150,"color":"2"},
