	"nodes":[
		{"id":"premise","type":"text","text":"Misma aplicacion, otra arquitectura\\nMantener topic, esquema, ventanas, features, modelo y metricas para comparar contra local.","x":-760,"y":-320,"width":350,"height":150,"color":"4"},
